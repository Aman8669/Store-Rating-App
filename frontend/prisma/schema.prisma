generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN
  NORMAL_USER
  STORE_OWNER
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  address  String?
  role     Role     @default(NORMAL_USER)
  stores   Store[]  @relation("StoreOwner")
  ratings  Rating[]
}

model Store {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  address  String
  ownerId  Int
  owner    User     @relation("StoreOwner", fields: [ownerId], references: [id])
  ratings  Rating[]
}

model Rating {
  id          Int   @id @default(autoincrement())
  ratingValue Int   // Constrained 1-5 in API
  userId      Int
  storeId     Int
  user        User  @relation(fields: [userId], references: [id])
  store       Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId]) // Ensures one rating per user per store
}